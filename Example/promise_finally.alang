// Promise 与 try/catch/finally 配合示例
// 说明：ALang 的 try/catch/finally 可与 async/await 和 Promise 完美配合，
//       实现异步操作中的资源清理和错误恢复。

println("== Promise 与 try/catch/finally 示例 ==");

// -------------------------------------------------------
// 1) 基本 try/catch/finally 与 async/await
// -------------------------------------------------------
println("\n--- 1) async/await + try/catch/finally ---");

async function fetchData(url) {
    println("  开始请求: ${url}");
    await sleep(50);
    if (url == "invalid") {
        throw "请求失败: " + url;
    }
    return { status: 200, body: "响应数据" };
}

async function safeFetch() {
    try {
        let result = await fetchData("https://api.example.com");
        println("  请求成功: ${result.body}");
    } catch (e) {
        println("  请求异常: ${e}");
    } finally {
        println("  finally: 清理网络资源");
    }
}

safeFetch().then([](v) {
    println("  safeFetch 完成");
});

// -------------------------------------------------------
// 2) finally 确保资源释放
// -------------------------------------------------------
println("\n--- 2) finally 确保资源释放 ---");

async function processWithLock() {
    println("  获取锁...");
    try {
        await sleep(30);
        println("  处理数据中...");
        // 模拟可能的错误
        let shouldFail = false;
        if (shouldFail) {
            throw "处理失败";
        }
        println("  处理完成");
    } catch (e) {
        println("  处理出错: ${e}");
    } finally {
        println("  释放锁（始终执行）");
    }
}

processWithLock().then([](v) {
    println("  processWithLock 完成");
});

// -------------------------------------------------------
// 3) Promise 链式调用中的错误恢复
// -------------------------------------------------------
println("\n--- 3) Promise 链式错误恢复 ---");

Promise.resolve("初始值")
    .then([](v) {
        println("  第一步: ${v}");
        return v + " -> 处理后";
    })
    .then([](v) {
        println("  第二步: ${v}");
        // 模拟错误
        throw "第二步出错";
    })
    .catch([](e) {
        println("  catch 捕获: ${e}");
        return "恢复的值"; // 从错误中恢复
    })
    .then([](v) {
        println("  恢复后继续: ${v}");
        return v;
    });

// -------------------------------------------------------
// 4) finally 与错误处理的嵌套
// -------------------------------------------------------
println("\n--- 4) 嵌套 finally ---");

async function nestedCleanup() {
    println("  外层操作开始");
    try {
        println("  内层操作开始");
        try {
            await sleep(20);
            throw "内层错误";
        } catch (inner) {
            println("  内层 catch: ${inner}");
            throw "外层错误"; // 重新抛出
        } finally {
            println("  内层 finally: 释放内层资源");
        }
    } catch (outer) {
        println("  外层 catch: ${outer}");
    } finally {
        println("  外层 finally: 释放外层资源");
    }
}

nestedCleanup().then([](v) {
    println("  nestedCleanup 完成");
});

// -------------------------------------------------------
// 5) 实际场景：数据库事务模拟
// -------------------------------------------------------
println("\n--- 5) 数据库事务模拟 ---");

async function dbTransaction(operations) {
    println("  BEGIN TRANSACTION");
    let committed = false;
    try {
        let i = 0;
        while (i < operations.len()) {
            println("  执行操作 ${i + 1}: ${operations[i]}");
            await sleep(10);
            if (operations[i] == "FAIL") {
                throw "操作失败: " + operations[i];
            }
            i = i + 1;
        }
        committed = true;
        println("  COMMIT");
    } catch (e) {
        println("  事务出错: ${e}");
        println("  ROLLBACK");
    } finally {
        if (committed) {
            println("  [finally] 事务已提交");
        } else {
            println("  [finally] 事务已回滚");
        }
    }
    return committed;
}

// 成功的事务
dbTransaction(["INSERT INTO users", "UPDATE profile"]).then([](ok) {
    println("  事务结果: ${ok}");
});

// 失败的事务
dbTransaction(["INSERT INTO users", "FAIL", "UPDATE profile"]).then([](ok) {
    println("  事务结果: ${ok}");
});

println("\n(脚本执行结束，事件循环将触发异步任务)");
